rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Server-managed collections (Firebase Admin SDK bypasses rules)
    match /entitlements/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /purchase_tokens/{tokenId} {
      allow read, write: if false;
    }

    match /rejections/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /rtdn_messages/{msgId} {
      allow read, write: if false;
    }

    // Free App Cloud Backup & Sync paths (UID-scoped & owner-only)
    match /user_backups/{userId} {
      allow read, write: if isOwner(userId);

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Travelling Pro app paths (Preserved compatibility)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // Public read: any authenticated user can view another traveller's countries, visited_countries, and cities
      match /countries/{countryId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);

        match /cities/{cityId} {
          allow read: if isAuthenticated();
          allow write: if isOwner(userId);
        }
      }

      match /visited_countries/{countryId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);

        match /cities/{cityId} {
          allow read: if isAuthenticated();
          allow write: if isOwner(userId);
        }
      }

      match /cities/{cityId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // All other subcollections remain owner-only
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /countries/{countryId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
